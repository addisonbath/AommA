      "shape_latent": [
        "upsample_sample",
        0
      ]
    }
  },
  "texture_sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "seed": 43,
      "steps": 12,
      "cfg": 1.0,
      "sampler_name": "euler",
