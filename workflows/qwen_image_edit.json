{
  "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "qwen_image_edit_fp8_e4m3fn.safetensors", "weight_dtype": "default"}},
  "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default"}},
  "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "shift": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["unet", 0], "shift": 3.0}},
  "cfgnorm": {"class_type": "CFGNorm", "inputs": {"model": ["shift", 0], "strength": 1.0}},
  "input_image": {"class_type": "LoadImage", "inputs": {"image": ""}},
  "scaled": {"class_type": "ImageScaleToTotalPixels", "inputs": {"image": ["input_image", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 16}},
  "input_prompt": {"class_type": "TextEncodeQwenImageEdit", "inputs": {"clip": ["clip", 0], "prompt": "", "vae": ["vae", 0], "image": ["scaled", 0]}},
  "negative": {"class_type": "TextEncodeQwenImageEdit", "inputs": {"clip": ["clip", 0], "prompt": "", "vae": ["vae", 0], "image": ["scaled", 0]}},
  "latent": {"class_type": "VAEEncode", "inputs": {"pixels": ["scaled", 0], "vae": ["vae", 0]}},
  "sampler": {"class_type": "KSampler", "inputs": {"model": ["cfgnorm", 0], "seed": 1, "steps": 20, "cfg": 2.5, "sampler_name": "euler", "scheduler": "simple",
              "positive": ["input_prompt", 0], "negative": ["negative", 0], "latent_image": ["latent", 0], "denoise": 1.0}},
  "edited": {"class_type": "VAEDecode", "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]}},
  "output_image": {"class_type": "PreviewImage", "inputs": {"images": ["edited", 0]}}
}
