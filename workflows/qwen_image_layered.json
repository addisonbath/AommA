{
  "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "qwen_image_layered_bf16.safetensors", "weight_dtype": "default"}},
  "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image"}},
  "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_layered_vae.safetensors"}},
  "shift": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["unet", 0], "shift": 1.0}},
  "input_image": {"class_type": "LoadImage", "inputs": {"image": ""}},
  "scaled": {"class_type": "ImageScale", "inputs": {"image": ["input_image", 0], "upscale_method": "lanczos", "width": 1024, "height": 640, "crop": "disabled"}},
  "reference": {"class_type": "VAEEncode", "inputs": {"pixels": ["scaled", 0], "vae": ["vae", 0]}},
  "input_prompt": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": ""}},
  "negative_prompt": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": " "}},
  "positive": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["input_prompt", 0], "latent": ["reference", 0]}},
  "negative": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["negative_prompt", 0], "latent": ["reference", 0]}},
  "empty": {"class_type": "EmptyQwenImageLayeredLatentImage", "inputs": {"width": 1024, "height": 640, "layers": 4, "batch_size": 1}},
  "sampler": {"class_type": "KSampler", "inputs": {"model": ["shift", 0], "seed": 1, "steps": 30, "cfg": 2.5, "sampler_name": "euler", "scheduler": "simple",
              "positive": ["positive", 0], "negative": ["negative", 0], "latent_image": ["empty", 0], "denoise": 1.0}},
  "split": {"class_type": "LatentCutToBatch", "inputs": {"samples": ["sampler", 0], "dim": "t", "slice_size": 1}},
  "decoded": {"class_type": "VAEDecode", "inputs": {"samples": ["split", 0], "vae": ["vae", 0]}},
  "output_image": {"class_type": "SaveImage", "inputs": {"images": ["decoded", 0], "filename_prefix": "aomma_layers"}}
}
